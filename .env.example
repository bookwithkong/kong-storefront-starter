# The operator whose catalogue this site sells.
KONG_ORGANIZATION_SLUG=your-organization-slug
NEXT_PUBLIC_KONG_ORGANIZATION_SLUG=your-organization-slug

# The operator's timezone and currency. Departure times are rendered in the
# timezone, and prices formatted with the currency code.
NEXT_PUBLIC_KONG_TIMEZONE=Asia/Kuala_Lumpur
NEXT_PUBLIC_KONG_CURRENCY=MYR

# This site's own origin, used as the post-payment return destination.
# It must EXACTLY match an origin declared in Kong under
# Website -> Custom site, or the booking is refused rather than ignored.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3100

# Where the chat assistant is served from — the operator's Kong storefront
# origin, NOT the API origin. Remove this line to drop the assistant.
NEXT_PUBLIC_KONG_STOREFRONT_ORIGIN=https://your-organization-slug.bookwithkong.com

# Omit to use production. Set this to target staging instead.
# KONG_API_ORIGIN=https://api.bookwithkong-staging.com
